<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The NativeAOT publish smoke test for the framework-free core. `dotnet publish` on this project
      must succeed with zero trim/AOT warnings, exercising the core public surface (handler contract,
      message, result, options, telemetry) in a rooted, trimmed, native binary. The EF Core store is
      deliberately excluded: EF Core is not NativeAOT-clean, so only the core carries the smoke.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moongazing.OrionInbox\Moongazing.OrionInbox.csproj" />
  </ItemGroup>
</Project>
