<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit fact names use snake_case (CA1707 does not apply to tests); CA1001/CA2007 are test-only noise. -->
    <NoWarn>$(NoWarn);CA1707;CS1591;CA1001;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="OrionClock.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moongazing.OrionInbox\Moongazing.OrionInbox.csproj" />
    <ProjectReference Include="..\..\src\Moongazing.OrionInbox.EntityFrameworkCore\Moongazing.OrionInbox.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
